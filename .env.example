# Telegram: токен от @BotFather (/newbot) и id чата/группы, куда слать заказы.
# chat_id группы отрицательный. Узнать: добавить бота в группу, написать
# сообщение, открыть https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets: id таблицы из адресной строки
# https://docs.google.com/spreadsheets/d/<ЭТО_ID>/edit
GOOGLE_SHEETS_ID=
# Сервис-аккаунт из Google Cloud Console (IAM → Service Accounts → ключ JSON).
# Таблицу нужно расшарить на этот e-mail как на редактора.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Поле private_key из JSON-ключа. Переносы строк записать как \n в одну строку.
GOOGLE_PRIVATE_KEY=

# Пароль страницы /admin (закрытые даты). Минимум 8 символов.
ADMIN_PASSWORD=
